<Window x:Class="PCAdminApp.Pages.EditTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PCAdminApp.Pages"
        mc:Ignorable="d"
        Title="EditTicketWindow" Height="450" Width="370" Background="#262626" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button Name="BtnCloseWindow" Click="BtnCloseWindow_Click"  Background="#363636" Margin="10" BorderThickness="0" HorizontalAlignment="Right">
            <materialDesign:PackIcon Kind="Close" Foreground="White"/>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Text="Работа с тикетом" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" Margin="0 5" FontSize="24" FontWeight="DemiBold" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Monitor" Foreground="White"/>
                <TextBlock Text="Название устройства" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="5 0"/>
            </StackPanel>
            <TextBox x:Name="TBComputerName" Width="200" HorizontalAlignment="Left" Padding="3" TextAlignment="Left">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Monitor" Foreground="White"/>
                <TextBlock Text="Описание тикета" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="5 0"/>
            </StackPanel>
            <TextBox x:Name="TBDescription" Width="200" HorizontalAlignment="Left" Padding="3" TextAlignment="Left">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CalendarDay" Foreground="White"/>
                <TextBlock Text="Дать создания тикета" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="5 0"/>
            </StackPanel>
            <DatePicker x:Name="DGCreated" Width="200" HorizontalAlignment="Left" Padding="3"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0 0 0 10">
            <Button x:Name="BtnTicketDone" Click="BtnTicketDone_Click" Content="Выполнен" Padding="5" Foreground="White" Background="#FB1B2A" BorderBrush="#BF131F">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="BtnSaveTicket" Click="BtnSaveTicket_Click" Margin="10 0 0 0" Content="Сохранить" Padding="5" Foreground="White" Background="#FB1B2A" BorderBrush="#BF131F">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Отмена" Name="BtnCancel" Margin="5 0" Padding="5" Click="BtnCancel_Click" Foreground="White" Background="#FF353434">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
