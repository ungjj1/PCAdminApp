<Page x:Class="PCAdminApp.Pages.PeripheriaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:PCAdminApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PeripheriaPage">

    <Page.Resources>
        <DataTemplate x:Key="PeripheriaTeplate">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnEditPeripheria" Click="BtnEditPeripheries_Click" Margin="5" Background="#E82E39" Grid.Column="0" Height="40">
                        <Button.Content>
                            <materialDesign:PackIcon Kind="Pencil" Foreground="White"/>
                        </Button.Content>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <StackPanel Orientation="Vertical" Margin="5 10" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CaseSensitiveAlt"/>
                            <TextBlock>
                                <Run Text="Название:" FontWeight="DemiBold"/>
                                <Run Text="{Binding ProfileName}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <materialDesign:PackIcon Kind="MouseOutline"/>
                            <TextBlock>
                            <Run Text="Мышь:" FontWeight="DemiBold"/>
                            <Run Text="{Binding MouseModel}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <materialDesign:PackIcon Kind="KeyboardOutline"/>
                            <TextBlock>
                            <Run Text="Клавиатура:" FontWeight="DemiBold"/>
                            <Run Text="{Binding KeyboardModel}"/>
                        </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <materialDesign:PackIcon Kind="Headset"/>
                            <TextBlock>
                            <Run Text="Наушники:" FontWeight="DemiBold"/>
                            <Run Text="{Binding HeadsetModel}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                            <materialDesign:PackIcon Kind="Monitor"/>
                            <TextBlock>
                                    <Run Text="Монитор:" FontWeight="DemiBold"/>
                                    <Run Text="{Binding MonitorModel}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="TBCountPC"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <ItemsControl x:Name="ListPheripheiral" ItemTemplate="{StaticResource PeripheriaTeplate}"/>
        </ScrollViewer>
    </Grid>
</Page>
