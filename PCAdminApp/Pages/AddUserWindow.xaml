<Window x:Class="PCAdminApp.Pages.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PCAdminApp.Pages"
        mc:Ignorable="d"
        Title="AddUserWindow" Height="300" Width="600" Background="#262626" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BtnCloseWin" Click="BtnCloseWin_Click" HorizontalAlignment="Right" Margin="0 5 5 0" Background="#262626" BorderThickness="0">
            <Button.Content>
                <materialDesign:PackIcon Kind="Close" Foreground="White"/>
            </Button.Content>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
            <TextBlock Text="Добавить пользователя" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Foreground="White" Margin="0 10"/>
            <TextBlock Text="ФИО пользователя" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="TBFullName" Width="200">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Логин" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="TBUserName" Width="200">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Пароль" Foreground="White" FontWeight="SemiBold"/>
            <TextBox x:Name="TBPassword" Width="200">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Роль" Foreground="White" FontWeight="SemiBold"/>
            <ComboBox Name="RoleComboBox"/>
            <Button x:Name="BtnSave" Click="BtnSave_Click" Content="Сохранить" Margin="0 10" BorderThickness="0" Padding="5" Foreground="White" FontWeight="DemiBold" Background="#E82E39">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel> 
    </Grid>
</Window>
